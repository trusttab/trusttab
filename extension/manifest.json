{
  "manifest_version": 3,
  "name": "TrustTab",
  "version": "0.1.0",
  "description": "See whether the site you're on is verified by TrustTab for AI agents. Checks only when you open the popup.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrustTab",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab"]
}
