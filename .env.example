# Copy to .env.local for local development. Never commit real values.
#
# On Vercel, set these in Project Settings → Environment Variables.
# (If you add Neon through the Vercel Marketplace, DATABASE_URL is injected
# automatically.)

# Postgres connection string.
# Local example: postgres://YOUR_USER@localhost:5432/trusttab_dev
DATABASE_URL=

# Secret used by Better Auth to sign session cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of this deployment, no trailing slash.
# Local: http://localhost:3000   Production: https://your-domain.example
BETTER_AUTH_URL=http://localhost:3000

# Identity of this TrustTab instance as a manifest issuer. A self-hosted
# instance is its own issuer — use your own name and public URL.
TRUSTTAB_ISSUER_NAME=
# Public base URL (must be https://), no trailing slash. Signed manifests reference it, and the
# signing keys are published at <this URL>/.well-known/jwks.json.
TRUSTTAB_ISSUER_URL=

# Ed25519 manifest-signing key (base64 PKCS#8 DER). Generate with:
#   npm run keys:generate
# Back it up securely: losing it invalidates every manifest you've issued.
TRUSTTAB_SIGNING_PRIVATE_KEY=

# Optional. If set, every page on this deployment includes
# <meta name="agenttrust-verify" content="..."> so the deployment can verify
# ownership of its own domain in its own dashboard.
AGENTTRUST_VERIFY_TOKEN=
